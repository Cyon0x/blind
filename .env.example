# Blind — environment. Copy to .env.local and fill in. Never commit real values.
#
# Nothing here is required for the app to *start*: Blind prints which pieces are
# missing instead of pretending they work. The pieces marked REQUIRED FOR
# PAYMENTS are what it takes to move real money.

# ---------------------------------------------------------------- app + session
# The public origin Blind builds links and OAuth callbacks from.
APP_URL=https://blind.example
# REQUIRED FOR SIGN-IN. 32+ random characters; signs session cookies and CSRF
# tokens. Rotating it signs everybody out.  `openssl rand -base64 48`
AUTH_SECRET=

# ------------------------------------------------------------------- database
# Neon/Vercel Postgres over HTTP. Without it Blind falls back to an embedded
# Postgres for local development and refuses to run that way in production.
DATABASE_URL_POOLED=
# Optional direct (unpooled) URL, used by `npm run db:migrate`.
DATABASE_URL=
# Development only: the embedded Postgres data directory, and an escape hatch
# that allows the embedded database in a production build. Leave unset in prod.
PGLITE_DIR=
ALLOW_EMBEDDED_DB_IN_PROD=

# ------------------------------------------------------------------ Google OAuth
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------- X OAuth
# Authorised redirect URI: ${APP_URL}/api/auth/x/callback
# X supports PKCE for public clients; if you use a confidential client, set the
# secret and X authenticates the token request with HTTP Basic.
# X_USE_PKCE=1 forces the public-client path even when a secret is present —
# set it if the X app was created as a public/native client.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USE_PKCE=
# OAuth scopes to request. Defaults to users.read, which is all Blind uses (the
# handle from users/me). A given X app may not be allowed to grant more until
# its user-authentication settings are configured, so keep this minimal.
X_SCOPES=

# ----------------------------------------------------------------------- Beldex
# mainnet | testnet | devnet. The address prefix table follows this. The default
# is testnet: an unconfigured deployment should fail safe. Blind was built and
# is deployed against Beldex testnet.
BDX_NETWORK=testnet
# REQUIRED FOR SETTLEMENT EVIDENCE (preferred). Beldex daemon JSON-RPC. Blind
# only ever reads from it; it never sends through the daemon. Takes precedence
# over the explorer below when both are set.
BDX_DAEMON_URL=
# A public mainnet node that answers over plain HTTP (HTTPS fails TLS there):
#   http://publicnode1.rpcnode.stream:29095/json_rpc
#
# SETTLEMENT EVIDENCE FALLBACK, used when no daemon is reachable. Beldex
# publishes no public testnet daemon, so on testnet Blind reads chain evidence
# from the official testnet explorer's JSON API. Evidence from it is marked
# untrusted and always names its source. Defaults to https://testnet.beldex.dev
# when BDX_NETWORK=testnet; set it to point at your own explorer or leave it
# empty on devnet.
BDX_EXPLORER_API_URL=
# REQUIRED FOR BLIND PAY / ESCROW REQUESTS. beldex-wallet-rpc for the escrow
# wallet. Keep it off the public internet and reachable only by the app.
BDX_WALLET_RPC_URL=
BDX_WALLET_RPC_USER=
BDX_WALLET_RPC_PASSWORD=
# Which wallet file the escrow service should have open, and which account.
BDX_ESCROW_WALLET=blind-escrow
BDX_ESCROW_ACCOUNT=0
# Confirmations Blind waits for before it calls a payment settled.
BDX_CONFIRMATIONS=10
# Refuse any payout when the escrow wallet's total balance exceeds this (atomic
# units). A fuse, not a substitute for watching the wallet.
BDX_ESCROW_HOT_CAP_ATOMIC=
# Largest single payment this deployment will create (atomic units).
BDX_MAX_PAYMENT_ATOMIC=1000000000000000
# Optional explorer for the "open in the explorer" links people click. Defaults
# to https://testnet.beldex.dev on testnet and https://explorer.beldex.io on
# mainnet, so it usually needs no value.
BDX_EXPLORER_URL=
# Wallet-signature framings accepted by /api/auth/wallet/verify, comma
# separated: plain, monero-prefix, beldex-prefix.
BDX_SIGNATURE_FRAMINGS=plain,beldex-prefix,monero-prefix
# Optional: let beldex-wallet-rpc pick fees from its own estimate rather than
# Blind's fixed priority mapping.
BDX_WALLET_RPC_PRIORITY_STYLE=

# ------------------------------------------------------------------- claim links
# REQUIRED FOR CLAIM LINKS TO BE RE-DISPLAYABLE and for username payments. A
# 32-byte key, hex or base64 (any other passphrase is stretched with scrypt).
# Seals the only secret Blind stores: a payment's claim secret. Rotating it
# makes existing stored links unrecoverable.  `openssl rand -hex 32`
BDX_CLAIM_KEY=
