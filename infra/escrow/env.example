# Infra only. Never commit the real file: copy to infra/escrow/.env
# (gitignored) and keep infra/escrow/secrets/ out of version control too.

BDX_VERSION=v7.0.4

# Credentials the app presents to beldex-wallet-rpc. Generate once, then set the
# same values in the app's environment (Vercel: BDX_WALLET_RPC_USER/PASSWORD).
BDX_WALLET_RPC_USER=blind
BDX_WALLET_RPC_PASSWORD=replace-with-a-long-random-string

# Must match the app's network. Blind is on testnet.
BDX_NETWORK=testnet
BDX_ESCROW_WALLET=blind-escrow
