{
  "name": "blind",
  "version": "0.1.0",
  "private": true,
  "description": "Blind — privacy-first payments and payment requests on Beldex.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:pglite": "node scripts/pglite-setup.mjs",
    "bdx:doctor": "node --import ./scripts/bdx/register-hooks.mjs scripts/bdx/doctor.mjs"
  },
  "dependencies": {
    "@bdxi/beldex-nettype": "^1.0.0",
    "@bdxi/web3js": "^1.0.1",
    "@neondatabase/serverless": "^1.2.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@bdxi/beldex-app-bridge": "^3.0.2",
    "@electric-sql/pglite": "^0.3.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
